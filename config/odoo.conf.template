[options]
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons
admin_passwd = ${ADMIN_PASSWD}
db_host = ${DB_HOST}
db_port = ${DB_PORT}
db_user = ${DB_USER}
db_password = ${DB_PASSWORD}
db_name = ${DB_NAME}
http_enable = True
http_interface = 0.0.0.0
http_port = 8069
proxy_mode = True
workers = 0
limit_time_cpu = 600
limit_time_real = 1200
list_db = True
log_level = info
xmlrpc_interface = 0.0.0.0
xmlrpc_port = 8069
