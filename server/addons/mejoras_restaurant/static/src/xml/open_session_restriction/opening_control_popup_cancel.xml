<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="mejoras_restaurant.OpeningControlPopupCancel"
       t-inherit="point_of_sale.OpeningControlPopup"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='footer']" position="inside">
            <button class="button btn btn-lg btn-secondary"
                    t-if="this.pos.config.module_pos_hr"
                    t-on-click="() => this.pos.showLoginScreen()">
                Cancelar
            </button>
        </xpath>
    </t>
</templates>
