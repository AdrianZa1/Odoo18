<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 
    =====================================================================
    Vista heredada: pos.payment.method
    =====================================================================
    Agrega el campo is_card_payment en la configuración de métodos de pago.
    Permite al administrador marcar qué métodos son pagos con tarjeta.
    -->
    
    <record id="view_pos_payment_method_form_inherit_card_brand" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.card.brand</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Agregar el campo después del campo 'name' -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_card_payment"/>
            </xpath>
            
        </field>
    </record>

</odoo>
